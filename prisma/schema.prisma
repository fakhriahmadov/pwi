generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  PENDING_PAYMENT   // sent to Stripe Checkout, not paid yet
  PENDING_APPROVAL  // invite-only event: waiting for the institute to approve
  APPROVED          // approved, payment link sent (or free)
  PAID              // paid — ticket issued
  ENQUIRY           // "on request" pass: the team follows up personally
  CANCELLED
}

model Registration {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  eventSlug       String
  passId          String
  passName        String
  quantity        Int                @default(1)
  amountCents     Int?
  currency        String             @default("eur")
  status          RegistrationStatus
  firstName       String
  lastName        String
  email           String
  phone           String?
  company         String?
  role            String?
  heardFrom       String?
  /// Invitation requests: where the person lives, their LinkedIn, and why they'd like to attend
  country         String?
  linkedin        String?
  message         String?
  vatNumber       String?
  invoiceCompany  String?
  marketingOptIn  Boolean            @default(false)
  stripeSessionId String?            @unique
  ticketCode      String?            @unique
  checkedInAt     DateTime?
  /// A member's request from My account: "cancel" or "transfer" (handled in Admin → Registrations)
  requestType     String?
  requestedAt     DateTime?
  /// For transfers: { name, email } of the colleague
  transferTo      Json?

  @@index([eventSlug, status])
  @@index([email])
}

model Enquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  topic     String   // general | partner | press | speak | data | report
  name      String
  email     String
  company   String?
  country   String?
  message   String?
  meta      Json?
  handled   Boolean  @default(false)
}

model Subscriber {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  email        String    @unique
  name         String?
  /// weekly | monthly | quarterly | annually — the subscriber's own choice
  frequency    String    @default("monthly")
  /// insights | events — what the digest includes for them
  topics       String[]  @default(["insights", "events"])
  source       String?
  confirmToken String?   @unique
  /// Secret for the "manage preferences" and unsubscribe links in every email
  manageToken  String?   @unique
  confirmedAt  DateTime?
  unsubscribed Boolean   @default(false)
}

/// One newsletter edition per frequency and due date. An admin approves (sends) or skips each one.
model NewsletterIssue {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  frequency  String    // weekly | monthly | quarterly | annually
  dueDate    String    // YYYY-MM-DD
  status     String    @default("draft") // draft | sent | skipped
  subject    String?
  intro      String?
  /// Keys of items the admin left out (e.g. "article:slug")
  excluded   String[]  @default([])
  /// Snapshot of what was sent
  items      Json?
  recipients Int       @default(0)
  sentAt     DateTime?
  by         String?

  @@unique([frequency, dueDate])
}

// ---------- About page content (edited in /admin/about) ----------

/// Uploaded images (portraits, logos). Served at /media/[id].
model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  filename  String
  mime      String
  size      Int
  data      Bytes
}

/// Single row (id = "about") holding the page's text and founder details.
model AboutContent {
  id             String   @id @default("about")
  updatedAt      DateTime @updatedAt
  intro          String?
  subIntro       String?
  founderName    String?
  founderRole    String?
  founderBio     String?
  founderQuote   String?
  founderPhotoId String?
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  role     String?
  bio      String?
  group    String  @default("team") // team | advisor
  photoId  String?
  linkedin String?
  order    Int     @default(0)
}

model Milestone {
  id    String @id @default(cuid())
  year  String
  text  String
  order Int    @default(0)
}

model Partner {
  id     String  @id @default(cuid())
  name   String
  kind   String  @default("partner") // partner | press
  url    String?
  logoId String?
  order  Int     @default(0)
}

/// One-time admin sign-in links (stored hashed; valid 15 minutes, single use).
model LoginToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

/// Admin passwords (scrypt-hashed). Admins set theirs at /admin/account.
model AdminUser {
  email        String   @id
  passwordHash String
  updatedAt    DateTime @updatedAt
}

/// Insight articles written in /admin/insights. Markdown body.
model Article {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  slug       String   @unique
  legacySlug String?
  title      String
  excerpt    String   @default("")
  topic      String   @default("Insights")
  author     String   @default("Fakhri Ahmadov")
  date       String   // YYYY-MM-DD
  body       String   @default("")
  coverId    String?
  status     String   @default("draft") // draft | published
  featured   Boolean  @default(false)
}

// ---------- Research: global indexes built from tagged fortune data ----------

/// One row per fortune per year, uploaded as CSV in /admin/research.
model Fortune {
  id         String   @id @default(cuid())
  year       Int
  name       String?
  country    String
  region     String
  industry   String?
  netWorthBn Float
  birthYear  Int?
  gender     String?
  /// Normalised tags: custom ones ("family-business") plus automatic ones
  /// ("region:europe", "country:spain", "industry:retail", "generation:gen-x", "gender:female").
  tags       String[]
  uploadId   String
  @@index([year])
}

model DataUpload {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  filename  String
  rows      Int
  years     Int[]
  by        String?
}

/// An index = a saved tag filter. Level = members' combined wealth vs the base year (= 100).
model IndexDef {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  allTags     String[] // a fortune must have every one of these
  anyTags     String[] // …and at least one of these (if any are given)
  baseYear    Int?
  color       String   @default("#C42F33")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// A spreadsheet waiting for its columns to be matched (deleted after import or after a day).
model PendingUpload {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  filename  String
  data      Bytes
  by        String?
}

// ---------- Editable page content (Admin → Pages) ----------

/// One editable block per page/section. `draft` holds unpublished edits; `published` is what visitors see.
model ContentBlock {
  key         String    @id
  draft       Json?
  published   Json?
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  updatedBy   String?
}

// ---------- Events (Admin → Events) ----------
model EventItem {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  status                  String    @default("draft") // draft | published
  data                    Json      // all event fields (see lib/event-schema.ts)
  updatedAt               DateTime  @updatedAt
  createdAt               DateTime  @default(now())
}

// ---------- Reports (Admin → Reports) ----------
model Report {
  id        String   @id @default(cuid())
  title     String
  date      String   // YYYY-MM-DD
  pages     Int?
  fileId    String
  gated     Boolean  @default(true)
  status    String   @default("draft")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------- Accounts (everyone who signs in) ----------

/// A person with an account. role: "member" (registrations, newsletter, profile) or "admin" (also the admin area).
/// Addresses in ADMIN_EMAILS are always admins.
model Member {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  email        String    @unique
  name         String    @default("")
  company      String?
  title        String?
  phone        String?
  role         String    @default("member") // member | admin
  status       String    @default("active") // active | disabled
  passwordHash String?
  method       String?   // how they last signed in: password | link | google | linkedin
  lastSignIn   DateTime?
  /// Investor-area confirmation: { confirmed: date, country, professional: true }
  investor     Json?
}

/// What a member did: registered, requested a transfer, changed newsletter settings…
model Activity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String
  text      String
  @@index([email, createdAt])
}

// ---------- Daily news (Admin → News; homepage "Today in private wealth") ----------
// Candidates are gathered automatically each morning; an editor publishes or dismisses them.
model NewsItem {
  id          String    @id @default(cuid())
  topic       String    // billionaires | unicorns | bankruptcies
  region      String    // europe | middle-east | latam | asia | north-america
  title       String
  takeaway    String?   // our one-line summary (written by the editor)
  figure      String?   // the key number, e.g. "+$4.2bn"
  source      String?   // publication name
  url         String    @unique
  publishedAt DateTime  // when the source published it
  status      String    @default("candidate") // candidate | published | dismissed
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  storyId     String?   // the story this headline went into (AI drafting groups headlines by event)

  @@index([status, region, topic, publishedAt])
}

// A story written by the institute (drafted by AI from several sources, or by an editor); shown on the site once published.
model NewsStory {
  id          String    @id @default(cuid())
  slug        String    @unique
  region      String    // europe | middle-east | latam | asia | north-america
  topic       String    // billionaires | unicorns | bankruptcies (not shown on the site)
  title       String
  figure      String?   // the key number, e.g. "+$4.2bn"
  takeaway    String?   // one line: why it matters to owners and families
  body        String    // about 150 words, plain paragraphs
  sources     Json      @default("[]") // [{ name, url }]
  status      String    @default("draft") // draft | published | dismissed
  eventDate   DateTime  // when the news broke
  aiDrafted   Boolean   @default(false)
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, region, eventDate])
}

/// What the AI news drafting cost per day (UTC), so it can stop at the daily budget.
model AiSpend {
  day       String   @id // YYYY-MM-DD (UTC)
  usd       Float    @default(0)
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A one-off side-by-side test of two models on the same headlines (Admin → News → Compare). Not published anywhere.
model NewsTrial {
  id        String   @id @default(cuid())
  region    String
  searches  Int
  result    Json
  createdAt DateTime @default(now())
}

/// News settings editors can change in Admin → News (one row, id "news").
model NewsSetting {
  id             String   @id @default("news")
  dailyBudgetUsd Float    @default(0.1)
  updatedAt      DateTime @updatedAt
}
