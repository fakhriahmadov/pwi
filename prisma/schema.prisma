generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  PENDING_PAYMENT   // sent to Stripe Checkout, not paid yet
  PENDING_APPROVAL  // invite-only event: waiting for the institute to approve
  APPROVED          // approved, payment link sent (or free)
  PAID              // paid — ticket issued
  ENQUIRY           // "on request" pass: the team follows up personally
  CANCELLED
}

model Registration {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  eventSlug       String
  passId          String
  passName        String
  quantity        Int                @default(1)
  amountCents     Int?
  currency        String             @default("eur")
  status          RegistrationStatus
  firstName       String
  lastName        String
  email           String
  phone           String?
  company         String?
  role            String?
  heardFrom       String?
  vatNumber       String?
  invoiceCompany  String?
  marketingOptIn  Boolean            @default(false)
  stripeSessionId String?            @unique
  ticketCode      String?            @unique
  checkedInAt     DateTime?

  @@index([eventSlug, status])
}

model Enquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  topic     String   // general | partner | press | speak | data | report
  name      String
  email     String
  company   String?
  country   String?
  message   String?
  meta      Json?
  handled   Boolean  @default(false)
}

model Subscriber {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  email        String    @unique
  source       String?
  confirmToken String?   @unique
  confirmedAt  DateTime?
  unsubscribed Boolean   @default(false)
}

// ---------- About page content (edited in /admin/about) ----------

/// Uploaded images (portraits, logos). Served at /media/[id].
model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  filename  String
  mime      String
  size      Int
  data      Bytes
}

/// Single row (id = "about") holding the page's text and founder details.
model AboutContent {
  id             String   @id @default("about")
  updatedAt      DateTime @updatedAt
  intro          String?
  subIntro       String?
  founderName    String?
  founderRole    String?
  founderBio     String?
  founderQuote   String?
  founderPhotoId String?
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  role     String?
  bio      String?
  group    String  @default("team") // team | advisor
  photoId  String?
  linkedin String?
  order    Int     @default(0)
}

model Milestone {
  id    String @id @default(cuid())
  year  String
  text  String
  order Int    @default(0)
}

model Partner {
  id     String  @id @default(cuid())
  name   String
  kind   String  @default("partner") // partner | press
  url    String?
  logoId String?
  order  Int     @default(0)
}

/// One-time admin sign-in links (stored hashed; valid 15 minutes, single use).
model LoginToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

/// Admin passwords (scrypt-hashed). Admins set theirs at /admin/account.
model AdminUser {
  email        String   @id
  passwordHash String
  updatedAt    DateTime @updatedAt
}

/// Insight articles written in /admin/insights. Markdown body.
model Article {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  slug       String   @unique
  legacySlug String?
  title      String
  excerpt    String   @default("")
  topic      String   @default("Insights")
  author     String   @default("Fakhri Ahmadov")
  date       String   // YYYY-MM-DD
  body       String   @default("")
  coverId    String?
  status     String   @default("draft") // draft | published
  featured   Boolean  @default(false)
}

// ---------- Research: global indexes built from tagged fortune data ----------

/// One row per fortune per year, uploaded as CSV in /admin/research.
model Fortune {
  id         String   @id @default(cuid())
  year       Int
  name       String?
  country    String
  region     String
  industry   String?
  netWorthBn Float
  birthYear  Int?
  gender     String?
  /// Normalised tags: custom ones ("family-business") plus automatic ones
  /// ("region:europe", "country:spain", "industry:retail", "generation:gen-x", "gender:female").
  tags       String[]
  uploadId   String
  @@index([year])
}

model DataUpload {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  filename  String
  rows      Int
  years     Int[]
  by        String?
}

/// An index = a saved tag filter. Level = members' combined wealth vs the base year (= 100).
model IndexDef {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  allTags     String[] // a fortune must have every one of these
  anyTags     String[] // …and at least one of these (if any are given)
  baseYear    Int?
  color       String   @default("#C42F33")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// A spreadsheet waiting for its columns to be matched (deleted after import or after a day).
model PendingUpload {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  filename  String
  data      Bytes
  by        String?
}
