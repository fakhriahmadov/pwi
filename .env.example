# Public URL of the site (used in emails, Stripe redirects, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.privatewealth.institute

# Postgres (Supabase, Neon or any Postgres). Run `npm run db:push` once.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Stripe — payments for summit passes
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — confirmation emails, e-tickets, newsletter opt-in
RESEND_API_KEY=re_...
EMAIL_FROM="Private Wealth Institute <info@privatewealth.institute>"
# Where contact-form and data-request notifications go
CONTACT_INBOX=info@privatewealth.institute

# Optional: newsletter sync to Brevo (list id from Brevo → Contacts → Lists)
BREVO_API_KEY=
BREVO_LIST_ID=

# Admin area at /admin (HTTP basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: cookie-free analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=privatewealth.institute
